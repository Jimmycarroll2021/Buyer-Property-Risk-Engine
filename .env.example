# Property Risk Engine — consolidated local paths and API credentials template
# Copy to .env and populate secrets locally. Never commit .env or actual keys.

# Core Engine Paths
# Defaults resolve from the current checkout. Uncomment and customize only if needed.
# RISK_PROJECT_ROOT=/absolute/path/to/Buyer-Property-Risk-Engine
# RISK_DATA_DIR=/absolute/path/to/Buyer-Property-Risk-Engine/runtime
# RISK_SOURCES_PATH=/absolute/path/to/Buyer-Property-Risk-Engine/config/sources_consolidated.json

# Stage 1-3 Ingestion Pipeline Paths (optional external reference)
# RISK_INGEST_ROOT=/absolute/path/to/optional-ingestion-workspace
# RISK_INGEST_CONTRACTS_PATH=/absolute/path/to/optional-ingestion-workspace/ingest_output/stage1_source_contracts.json
# RISK_INGEST_OUTPUT_DIR=/absolute/path/to/optional-ingestion-workspace/ingest_output

# Local Server
RISK_HOST=127.0.0.1
RISK_PORT=8000
# RISK_API_KEYS_JSON={"replace-with-long-random-secret":"your-tenant"}

# Authenticated External Source Credentials (set locally in .env)
GEOSCAPE_API_KEY=
GEOSCAPE_API_SECRET=
TRANSPORT_ACT_CLIENT_ID=
TRANSPORT_ACT_CLIENT_SECRET=
SILO_USER_EMAIL=api@example.com
