{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:property-risk-engine:case:0.1.0",
  "title": "Property risk case input",
  "description": "A tenant-scoped buyer case. Missing financial values are valid unknowns and must not be replaced with zero. Additional metadata is preserved in the input hash but does not imply a supported calculation.",
  "$comment": "Documentation and optional client validation only. These files are not automatically applied by the HTTP service. Engine/storage validation and semantic eligibility gates remain authoritative. Requirement/scenario ID uniqueness, chronological eligibility, supported loan forms, rate units, cash reconciliation and mutually exclusive cost representations require semantic engine validation.",
  "type": "object",
  "properties": {
    "case_id": {
      "type": "string",
      "minLength": 1
    },
    "property_id": {
      "type": "string",
      "minLength": 1
    },
    "owner_tenant_id": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "as_of": {
      "anyOf": [
        {
          "type": "string",
          "format": "date"
        },
        {
          "type": "string",
          "format": "date-time"
        }
      ],
      "description": "ISO date, or timezone-aware timestamp. A date is midnight UTC. Enable format checking in a client validator."
    },
    "assessment_mode": {
      "type": "string",
      "description": "A display/workflow mode. public_screen does not remove private due-diligence checks."
    },
    "property": {
      "type": "object",
      "properties": {
        "label": {
          "type": "string"
        },
        "jurisdiction": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "property_type": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "ownership_form": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "identity_confirmed": {
          "type": "boolean"
        },
        "ambiguous": {
          "type": "boolean"
        },
        "unit_required": {
          "type": "boolean"
        },
        "unit_id": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "parcel_id": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "parcel_geometry": {
          "type": "object",
          "properties": {
            "type": {
              "enum": [
                "Polygon",
                "MultiPolygon"
              ]
            },
            "coordinates": {
              "type": "array"
            },
            "geometries": {
              "type": "array",
              "maxItems": 0
            }
          },
          "additionalProperties": true,
          "required": [
            "type"
          ],
          "description": "GeoJSON polygon geometry. GeometryCollection is permitted only as an explicitly empty hazard extent. Topology, finite coordinates and CRS are checked by the engine.",
          "allOf": [
            {
              "if": {
                "properties": {
                  "type": {
                    "enum": [
                      "Polygon",
                      "MultiPolygon"
                    ]
                  }
                }
              },
              "then": {
                "required": [
                  "coordinates"
                ]
              }
            },
            {
              "if": {
                "properties": {
                  "type": {
                    "const": "GeometryCollection"
                  }
                }
              },
              "then": {
                "required": [
                  "geometries"
                ]
              }
            }
          ]
        },
        "footprint_geometry": {
          "type": "object",
          "properties": {
            "type": {
              "enum": [
                "Polygon",
                "MultiPolygon"
              ]
            },
            "coordinates": {
              "type": "array"
            },
            "geometries": {
              "type": "array",
              "maxItems": 0
            }
