        },
        "summary": {
          "type": "string"
        },
        "scope": {
          "type": "string"
        },
        "requirement_id": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "conflict": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "factor_id": {
          "type": [
